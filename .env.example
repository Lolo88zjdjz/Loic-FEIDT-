# ── Base de données (obligatoire) ──────────────────────────────
DATABASE_URL=postgres://loic:loic_dev_password@localhost:5432/loic_os
TEST_DATABASE_URL=postgres://loic:loic_dev_password@localhost:5432/loic_os_test

# ── Authentification (obligatoire) ─────────────────────────────
# Mot de passe initial du compte propriétaire, utilisé uniquement par `pnpm db:seed`.
LOIC_OS_OWNER_EMAIL=loic@localhost
LOIC_OS_OWNER_PASSWORD=change-me-please
# Chaîne aléatoire de 32+ caractères (openssl rand -hex 32)
SESSION_SECRET=

# ── IA GRATUITE (par défaut) ───────────────────────────────────
# Ollama local : aucun coût API, données sur votre machine. Voir README → « IA gratuite ».
OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_THINK=1 active le mode « réflexion » des modèles qui le supportent (beaucoup plus lent sur CPU)
# Quotas gratuits facultatifs (0 $ dans la limite du quota ; conditions de données à vérifier) :
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# ── IA PAYANTE (facultative, désactivée par défaut) ────────────
# Clé DÉDIÉE à LOÏC OS, facturée à l'usage. Distincte de votre abonnement Claude / Claude Code :
# l'application ignore ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN et ANTHROPIC_BASE_URL.
# Même avec une clé, aucun appel payant tant que Settings → Politique de coût = « 100 % gratuit ».
LOIC_OS_ANTHROPIC_API_KEY=
LOIC_OS_REFUSAL_FALLBACK=1

# ── Embeddings (facultatif : sans fournisseur, recherche plein texte + trigrammes + graphe)
VOYAGE_API_KEY=

# ── Intégrations Google (non implémentées : voir IMPLEMENTATION_STATUS.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Stockage des documents
STORAGE_DIR=./storage
