# ── Base de données (obligatoire) ──────────────────────────────
DATABASE_URL=postgres://loic:loic_dev_password@localhost:5432/loic_os
TEST_DATABASE_URL=postgres://loic:loic_dev_password@localhost:5432/loic_os_test

# ── Authentification (obligatoire) ─────────────────────────────
# Mot de passe initial du compte propriétaire, utilisé uniquement par `pnpm db:seed`.
LOIC_OS_OWNER_EMAIL=loic@localhost
LOIC_OS_OWNER_PASSWORD=change-me-please
# Chaîne aléatoire de 32+ caractères (openssl rand -hex 32)
SESSION_SECRET=

# ── IA (facultatif : sans clé, ATLAS fonctionne en mode déterministe) ──
# Facturation API Anthropic, distincte d'un abonnement Claude / Claude Code.
ANTHROPIC_API_KEY=
# Active le repli serveur en cas de refus (beta server-side-fallback-2026-07-01)
LOIC_OS_REFUSAL_FALLBACK=1

# ── Embeddings (facultatif : sans fournisseur, recherche plein texte + trigrammes + graphe)
VOYAGE_API_KEY=

# ── Intégrations Google (non implémentées : voir IMPLEMENTATION_STATUS.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Stockage des documents
STORAGE_DIR=./storage
