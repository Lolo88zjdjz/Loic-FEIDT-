{
  "name": "loic-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts && pnpm db:migrate && pnpm db:seed",
    "graph:check": "tsx scripts/graph-integrity.ts",
    "worker": "tsx worker/index.ts",
    "backup": "bash scripts/backup.sh",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs",
    "llm:eval": "tsx scripts/llm-eval.ts",
    "llm:sync": "tsx scripts/llm-sync.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "bcryptjs": "^3.0.3",
    "cytoscape": "^3.35.0",
    "cytoscape-fcose": "^2.2.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.75.0",
    "mammoth": "^1.13.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "unpdf": "^2.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/bcryptjs": "^3.0.0",
    "@types/cytoscape": "^3.31.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
